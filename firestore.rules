rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function superAdmin(){ return signedIn() && request.auth.token.superAdmin == true; }

    match /admin_users/{id} { allow read, write: if superAdmin(); }
    match /system_settings/{id} { allow read, write: if superAdmin(); }
    match /model_configs/{id} { allow read, write: if superAdmin(); }
    match /api_secret_metadata/{id} { allow read, write: if superAdmin(); }
    match /admin_audit_logs/{id} { allow read: if superAdmin(); allow write: if false; }

    match /{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
